#!/usr/bin/env python3
import sys
from pathlib import Path, PurePosixPath

CONF_REL = Path("etc/rpi-image-gen/slot-shared.d")
MANIFEST_REL = Path("etc/rpi-image-gen/slot-shared.manifest")


def fail(message: str) -> None:
    raise ValueError(message)


def normalize_path(raw: str, source: Path) -> str:
    if not raw.startswith("/"):
        fail(f"{source}: Path must be absolute: {raw!r}")
    if any(ch.isspace() for ch in raw):
        fail(f"{source}: whitespace is not supported in Path: {raw!r}")
    if any(part in (".", "..") for part in raw.split("/")):
        fail(f"{source}: Path contains '.' or '..': {raw!r}")
    value = str(PurePosixPath(raw))
    if value == "/":
        fail(f"{source}: refusing to share filesystem root")
    return value


def parse_conf(path: Path):
    version = None
    entries = []
    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            fail(f"{path}:{lineno}: expected key=value")
        key, value = (part.strip() for part in line.split("=", 1))
        if key == "Version":
            if version is not None and version != value:
                fail(f"{path}:{lineno}: conflicting Version values")
            version = value
        elif key == "Path":
            entries.append(normalize_path(value, path))
    if version != "1":
        fail(f"{path}: unsupported slot-shared version {version or 'missing'!r}")
    return entries


def depth(path: str) -> int:
    return len(PurePosixPath(path).parts)


def compile_manifest(root: Path) -> Path:
    conf_dir = root / CONF_REL
    manifest = root / MANIFEST_REL
    manifest.parent.mkdir(parents=True, exist_ok=True)

    entries = []
    if conf_dir.is_dir():
        for conf in sorted(conf_dir.glob("*.conf")):
            entries.extend((value, conf) for value in parse_conf(conf))

    seen = {}
    for value, source in entries:
        if value in seen:
            fail(f"duplicate Path {value!r}: {seen[value]} and {source}")
        seen[value] = source

    ordered = sorted(entries, key=lambda item: (depth(item[0]), item[0], str(item[1])))
    for i, (parent, parent_source) in enumerate(ordered):
        prefix = parent.rstrip("/") + "/"
        for child, child_source in ordered[i + 1:]:
            if depth(child) <= depth(parent):
                continue
            if child.startswith(prefix) and child_source != parent_source:
                fail(
                    "overlapping Paths from different drop-ins: "
                    f"{parent!r} ({parent_source}) and {child!r} ({child_source})"
                )

    lines = ["Version=1", *(f"Path={value}" for value, _ in ordered)]
    manifest.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return manifest


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit(f"usage: {Path(sys.argv[0]).name} <rootfs>")
    try:
        manifest = compile_manifest(Path(sys.argv[1]))
    except (OSError, ValueError) as exc:
        print(f"slot-shared-manifest: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
    print(manifest)


if __name__ == "__main__":
    main()
