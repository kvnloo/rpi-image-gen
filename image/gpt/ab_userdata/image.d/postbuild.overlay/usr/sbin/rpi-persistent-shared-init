#!/bin/sh

# Seed shared directories under /persistent/shared from the build-time manifest.

set -eu

MANIFEST=/etc/rpi-image-gen/slot-shared.manifest
SHARED_BASE=/persistent/shared
[ -f "$MANIFEST" ] || exit 0

version=""
paths=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
        Version) version="$value" ;;
        Path)    paths="$paths $value" ;;
    esac
done < "$MANIFEST"

if [ "$version" != "1" ]; then
    printf 'persistent-shared-init: unsupported manifest version "%s", skipping\n' "${version:-missing}" >&2
    exit 0
fi

for path in $paths; do
    printf 'persistent-shared-init: %s\n' "$path"
    mkdir -p "${SHARED_BASE}${path}"
    [ -d "$path" ] && rsync -av --checksum "$path/" "${SHARED_BASE}${path}/"
done
